{
    "name": "aaemnnosttv/last-modified-timestamp",
    "description": "A WordPress plugin for making the last modified date/time more accessible.",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=5.3",
        "composer/installers": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^7 || ^9",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "Evan Mattson",
            "email": "me@aaemnnost.tv"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
